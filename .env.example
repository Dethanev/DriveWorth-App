# ==========================================
# Supabase 設定 (雲端資料庫與驗證)
# ==========================================

# Supabase 專案的 API 網址
SUPABASE_URL=http://your-server-url:port
# Supabase 的匿名金鑰 (用於客戶端存取)
SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Supabase 服務角色金鑰 (僅限後端 FastAPI 使用，請勿流出)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here


# ==========================================
# API 設定 (DriveWorth 後端伺服器)
# ==========================================

# 如果在區網內（本地開發通常是 http://127.0.0.1:8000)
API_URL=http://127.0.0.1:8000
# 如果你有架設 Cloudflare Tunnel 或 DDNS 網域
# API_URL=https://api.your-backend-api-url:port
# API 版本號
API_VERSION=v1
# JWT 加密密鑰 (用於後端驗證)
JWT_SECRET=your_jwt_secret_must_be_secure


# ==========================================
# 專案環境設定
# ==========================================
# 運行環境: development (開發) 或 production (正式)

ENV=development